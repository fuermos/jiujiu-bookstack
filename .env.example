# jiujiu-bookstack 环境变量模板
# 复制: cp .env.example .env
# 然后填真实值

# PostgreSQL (默认值, 可不改)
POSTGRES_USER=admin
POSTGRES_PASSWORD=postgres_pwd_change_me
POSTGRES_DB=jiujiu_mind

# MiniMax LLM API Key (剧本生成主模型, 必填)
# 从 https://api.minimaxi.com 申请
MINIMAX_API_KEY=your_minimax_api_key_here

# 本地 LLM Fallback (可选, 默认 192.168.0.14:2345)
# LLM_FALLBACK_URL=http://192.168.0.14:2345/v1
